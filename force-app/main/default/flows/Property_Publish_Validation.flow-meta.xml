<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Log_Missing_Fields_Error</name>
        <label>Log Missing Fields Error</label>
        <locationX>300</locationX>
        <locationY>450</locationY>
        <actionName>ErrorLogger</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>errorMessage</name>
            <value>
                <stringValue>Property was marked Published but is missing one or more required fields. It has been automatically unpublished.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>source</name>
            <value>
                <stringValue>Property_Publish_Validation Flow</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>objectType</name>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>severity</name>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </inputParameters>
        <nameSegment>ErrorLogger</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Send_Published_Notification</name>
        <label>Send Published Notification</label>
        <locationX>50</locationX>
        <locationY>250</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <stringValue>0MLdN000000bJEzWAM</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>Recipient_Ids</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Property Published</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>Notification_Body</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Recipient_List</name>
        <label>Build Recipient List</label>
        <locationX>50</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>Recipient_Ids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Published_Notification</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Unpublished</name>
        <label>Set Unpublished</label>
        <locationX>300</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>$Record.Is_Published__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Unpublish</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Required_Fields</name>
        <label>Check Required Fields</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>No Action Needed</defaultConnectorLabel>
        <rules>
            <name>Missing_Fields</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Missing_Required_Fields</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Unpublished</targetReference>
            </connector>
            <label>Missing Fields</label>
        </rules>
        <rules>
            <name>Fields_Complete_And_Just_Published</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Missing_Required_Fields</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Just_Became_Published</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Recipient_List</targetReference>
            </connector>
            <label>Fields Complete And Just Published</label>
        </rules>
    </decisions>
    <formulas>
        <name>Missing_Required_Fields</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK(TEXT({!$Record.Property_Type__c})) || ISBLANK(TEXT({!$Record.Listing_Type__c})) || ISBLANK(TEXT({!$Record.Status__c})) || ISNULL({!$Record.Price__c}) || ISNULL({!$Record.Bedrooms__c}) || ISNULL({!$Record.Bathrooms__c}) || ISNULL({!$Record.Area_Sqft__c}) || ISBLANK({!$Record.Description__c}) || ISBLANK({!$Record.Property_Image_URL__c})</expression>
    </formulas>
    <formulas>
        <name>Just_Became_Published</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Is_Published__c})</expression>
    </formulas>
    <interviewLabel>Property Publish Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Property Publish Validation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Save_Unpublish</name>
        <label>Save Unpublish</label>
        <locationX>300</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Log_Missing_Fields_Error</targetReference>
        </connector>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Required_Fields</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Is_Published__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Notification_Body</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.Name} has been published on the website.</text>
    </textTemplates>
    <variables>
        <name>Recipient_Ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
